{
    "dockerComposeFile": "docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspaces/nestjs-libs",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/usr/bin/zsh"
            }
        }
    },
    "forwardPorts": [
        3000,
        4200,
        1883,
        6379,
        5540
    ],
    "remoteUser": "root",
    "postStartCommand": "service docker start"
}