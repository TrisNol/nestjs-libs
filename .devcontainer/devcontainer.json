{
    "dockerComposeFile": "docker-compose.yml",
    "service": "devcontainer",
    "workspaceFolder": "/workspaces/nestjs-libs",
    "customizations": {
        "vscode": {
            "settings": {
                "terminal.integrated.shell.linux": "/usr/bin/zsh"
            }
        }
    },
    "features": {
        "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
            "moby": "false"
        }
    },
    "forwardPorts": [
        3000,
        4200,
        1883,
        6379,
        5540
    ],
    "remoteUser": "vscode"
}